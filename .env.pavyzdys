# Nukopijuok si faila i .env ir uzpildyk. .env i git NEKELIAMAS.
#   cp .env.pavyzdys .env

# --- Shopify ---------------------------------------------------------------
# Admin -> Settings -> Apps and sales channels -> Develop apps -> Create an app
# -> Configure Admin API scopes: read_orders, read_products, read_inventory,
#    read_shopify_payments_payouts
# -> Install app -> Reveal token (prasideda shpat_)
SHOPIFY_PARDUOTUVE=inmmjj-kg.myshopify.com
SHOPIFY_RAKTAS=
# Jei API grazina "unsupported version", pasizurek dabar palaikoma versija
# admin -> Settings -> Apps -> Develop apps -> API versions.
SHOPIFY_API_VERSIJA=2026-07

# --- Meta ------------------------------------------------------------------
# business.facebook.com -> Business settings -> Users -> System users
# -> Add -> Assign assets (reklamos paskyra, Manage) -> Generate new token
# -> teises: ads_read
# Reklamos paskyros ID rasi Ads Manager URL: act=XXXXXXXXXX
META_RAKTAS=
META_PASKYRA=act_
META_API_VERSIJA=v23.0

# --- Prielaidos ------------------------------------------------------------
# Visos siitos reiksmes NENURODYTOS specialiai. Kol ju nera, atitinkama P&L
# eilute dashboarde lieka TUSCIA, o grynas pelnas nerodomas — geriau bruksnys
# nei isgalvotas skaicius. Uzpildyk tada, kai tureisi tikra skaiciu.
#
# Kiek realiai kainuoja issiusti viena siunta:
#   LP Express saskaitos suma / siuntu skaicius toje saskaitoje.
SIUNTOS_SAVIKAINA=

# Paysera tarifas — reikalingas TIK jei nekeli Shopify ataskaitos
# „Payment processing fees by month" ir neprijungei Shopify API.
PAYSERA_PROC=
PAYSERA_FIKS=0.00

# COD — atsiskaitymas atsiimant. Kurjeris surenka grynuosius ir perveda mums,
# nusiimdamas mokesti uz surinkima (ieskok LP Express saskaitoje).
# Nenurodyta — mokejimu eilute lieka tuscia tomis dienomis, kai buvo COD.
COD_MOKESTIS=
COD_PROC=0.0
# Kaip COD vadinasi Shopify (Settings -> Payments -> Manual payment methods).
# Keli variantai per kableli, didziosios/mazosios nesvarbu.
COD_GATEWAY=cash on delivery,cod,grynais,atsiimant
# Po kiek dienu neapmoketa COD siunta laikoma greiciausiai neatsiimta.
COD_LAUKIMAS=21

# Fiksuotos islaidos per menesi bendra suma. Geriau pildyk pelnas/islaidos.csv
# po viena eilute kiekvienam appsui — matysi, kur pinigai eina.
FIKSUOTOS_MENESIUI=

# Nuo kada traukti uzsakymus pirma karta.
PRADZIA=2025-09-01
